{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔄 Auto-Commit & Sync (Background)",
      "type": "shell",
      "command": "./scripts/autocommit.sh",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^🔄 Auto-commit listener started.*",
          "endsPattern": "^.*"
        }
      }
    }
  ]
}
